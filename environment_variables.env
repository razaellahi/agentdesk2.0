# Agent Desk 2.0 runtime configuration.
# Rendered into config.json by docker/entrypoint.sh (envsubst) at container start.
# Every value is optional unless marked REQUIRED; empty values fall back to the defaults
# in src/config/runtimeConfig.schema.ts. Booleans accept true/false, numbers accept digits.

# --- Backend services (REQUIRED). Hosts are rewritten to the page origin when
# --- REWRITE_URL_HOST_TO_ORIGIN=true, so one value works for every tenant FQDN.
GAT_URL=https://efcx.expertflow.com/agent-manager
SOCKET_URL=https://efcx.expertflow.com/agent-manager
FILE_SERVER_URL=https://efcx.expertflow.com/file-engine/1
CCM_URL=https://efcx.expertflow.com/ccm
CIM_CUSTOMER_URL=https://efcx.expertflow.com/cim-customer
CONVERSATION_MANAGER_URL=https://efcx.expertflow.com/conversation-manager
ROUTING_ENGINE_URL=https://efcx.expertflow.com/routing-engine
CIM_REPORTING_URL=https://efcx.expertflow.com/realtime-reports
UNIFIED_ADMIN_URL=https://efcx.expertflow.com/unified-admin
TEAM_ANNOUNCEMENT_URL=https://efcx.expertflow.com/team-announcement
SECURE_LINK_URL=https://efcx.expertflow.com/secure-link
CX_TENANT_URL=https://efcx.expertflow.com/cx-tenant
QM_URL=https://efcx.expertflow.com/qm-backend
LLM_CONNECTOR_URL=https://efcx.expertflow.com/llm
# VRS API is served under /vrs on this origin.
VRS_URL=https://efcx.expertflow.com

# --- Voice (CX Voice / SIP)
SIP_SOCKET_URL=
SIP_URI=
ROOT_DOMAIN=expertflow.com

# --- Behaviour
SOCKET_TIMEOUT=20000
ENV=prod
getQueuesDelay=15
DASHBOARD_REFRESH_TIME=10000
isCallingComplianceEnabled=false
ENABLE_FILE_ENGINE_EXTERNAL_FQDN=false
# Comma separated internalFqdn:externalFqdn pairs.
FILE_ENGINE_FQDN_MAPPING=

# --- Recordings (VRS): CISCO | EFCX
DEPLOYMENT_PROFILE=EFCX
VRS_TENANT_HEADER=VRS

# --- Multi-tenancy: subdomain | fixed | header
TENANT_MODE=subdomain
TENANT_ID=
DEFAULT_TENANT=expertflow

# --- Language & theme: light | dark | system
DEFAULT_LANGUAGE=en
DEFAULT_THEME=system

# --- App
BASE_PATH=/agent-desk/
REWRITE_URL_HOST_TO_ORIGIN=true
# Space separated origins allowed to embed Agent Desk (Finesse, CRM). 'self' is always allowed.
FRAME_ANCESTORS=
GOOGLE_MAPS_API_KEY=
FIREBASE_CONFIG=
GTM_ID=
ERROR_REPORTING_DSN=
LOG_LEVEL=warn
MAX_BOARD_PANES=3

# --- Feature flags
feature_CIM_32834_customisedDashboard=false
feature_CIM_33144_quick_replies=true
feature_multiPaneBoard=true
feature_aiWidgetGenerator=false
feature_recordings=true
