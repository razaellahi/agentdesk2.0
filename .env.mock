# Loaded by `pnpm mock` (vite --mode mock) only.
# Every mock login gets the Case Management superuser role, so all the case pages
# (Workbench, Create case, Dashboard, Reports, Admin) can be opened whoever you sign in as.
# The e2e run sets this to false (playwright.config.ts) so permission tests keep each user's real roles.
VITE_MOCK_FULL_CASE_ACCESS=true

# The demo starts with three live chats (WhatsApp, web, Facebook) and labelled customers, so the whole workspace has something to show.
# The e2e run sets this to false (playwright.config.ts): its tests seed their own conversations.
VITE_MOCK_LIVE_CHATS=true
